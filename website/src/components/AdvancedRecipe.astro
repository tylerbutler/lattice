---
interface Props {
	id: string;
	title: string;
	description: string;
}

const { id, title, description } = Astro.props;
---

<details class="advanced-recipe" id={id}>
	<summary>
		<span class="recipe-label">Advanced recipe</span>
		<span class="recipe-title">{title}</span>
		<span class="recipe-description">{description}</span>
	</summary>
	<div class="recipe-body">
		<slot />
	</div>
</details>

<script>
	declare global {
		interface Window {
			__latticeAdvancedRecipeListeners?: AbortController;
		}
	}

	const linkedRecipe = (
		hash: string,
	): HTMLDetailsElement | undefined => {
		const fragment = hash.slice(1);
		if (!fragment) return undefined;

		let id = fragment;
		try {
			id = decodeURIComponent(fragment);
		} catch {
			return undefined;
		}

		const recipe = document.getElementById(id);
		if (
			recipe instanceof HTMLDetailsElement &&
			recipe.classList.contains("advanced-recipe")
		) {
			return recipe;
		}

		return undefined;
	};

	const revealLinkedRecipe = (hash = window.location.hash) => {
		const recipe = linkedRecipe(hash);
		if (!recipe) return;

		recipe.open = true;
		requestAnimationFrame(() => recipe.scrollIntoView({ block: "start" }));
	};

	const revealRepeatedRecipeLink = (event: MouseEvent) => {
		if (
			event.defaultPrevented ||
			event.button !== 0 ||
			event.metaKey ||
			event.ctrlKey ||
			event.shiftKey ||
			event.altKey
		) {
			return;
		}

		const target = event.target;
		if (!(target instanceof Element)) return;

		const link = target.closest("a[href]");
		if (
			!(link instanceof HTMLAnchorElement) ||
			link.hasAttribute("download") ||
			(link.target && link.target !== "_self")
		) {
			return;
		}

		const destination = new URL(link.href, window.location.href);
		if (
			destination.origin !== window.location.origin ||
			destination.pathname !== window.location.pathname ||
			destination.search !== window.location.search ||
			destination.hash !== window.location.hash ||
			!linkedRecipe(destination.hash)
		) {
			return;
		}

		requestAnimationFrame(() => revealLinkedRecipe(destination.hash));
	};

	window.__latticeAdvancedRecipeListeners?.abort();
	const listenerController = new AbortController();
	window.__latticeAdvancedRecipeListeners = listenerController;

	revealLinkedRecipe();
	document.addEventListener("astro:page-load", () => revealLinkedRecipe(), {
		signal: listenerController.signal,
	});
	window.addEventListener("hashchange", () => revealLinkedRecipe(), {
		signal: listenerController.signal,
	});
	document.addEventListener("click", revealRepeatedRecipeLink, {
		signal: listenerController.signal,
	});
</script>

<style>
	.advanced-recipe {
		max-width: 72ch;
		margin-block: 1rem;
		border: 1px solid var(--lattice-rule);
		border-radius: 1rem;
		background: var(--lattice-panel-raised);
		scroll-margin-top: 6rem;
	}

	.advanced-recipe[open] {
		border-color: color-mix(
			in oklab,
			var(--sl-color-accent),
			var(--lattice-rule) 58%
		);
	}

	summary {
		padding: 1rem 1.1rem;
		border-radius: calc(1rem - 1px);
		color: var(--sl-color-gray-1);
		cursor: pointer;
	}

	.advanced-recipe[open] summary {
		border-end-start-radius: 0;
		border-end-end-radius: 0;
	}

	summary:focus-visible {
		position: relative;
		z-index: 1;
	}

	summary:hover {
		background: color-mix(
			in oklab,
			var(--sl-color-accent-low),
			transparent 72%
		);
	}

	summary::marker {
		color: var(--sl-color-accent);
	}

	.recipe-label,
	.recipe-title,
	.recipe-description {
		display: block;
		margin-inline-start: 0.25rem;
	}

	.recipe-label {
		margin-block-end: 0.35rem;
		color: var(--sl-color-accent-high);
		font-size: 0.82rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.recipe-title {
		font-family: var(--sl-font-headings);
		font-size: clamp(1.15rem, 3vw, 1.4rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.recipe-description {
		margin-block-start: 0.35rem;
		color: var(--lattice-text-muted);
		line-height: 1.45;
	}

	.recipe-body {
		min-width: 0;
		padding: 0.25rem 1.1rem 1.1rem;
		border-top: 1px solid var(--lattice-rule);
		border-end-start-radius: calc(1rem - 1px);
		border-end-end-radius: calc(1rem - 1px);
		overflow: clip;
	}

	:global(.recipe-body > :first-child) {
		margin-top: 1rem;
	}

	:global(.recipe-body > :last-child) {
		margin-bottom: 0;
	}

	@media (max-width: 30rem) {
		summary,
		.recipe-body {
			padding-inline: 0.85rem;
		}
	}
</style>
