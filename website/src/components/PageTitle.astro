---
const { entry } = Astro.locals.starlightRoute;
const title = entry.data.title;
const description = entry.data.description;
const PAGE_TITLE_ID = "_top";
const section = entry.id.includes("/")
	? (entry.id.split("/")[0] ?? "start")
	: "start";

const sectionLabels: Record<string, string> = {
	advanced: "advanced note",
	guides: "field guide",
	start: "orientation",
};

const sectionLabel = sectionLabels[section] ?? section;
---

<header class="proof-title" aria-labelledby={PAGE_TITLE_ID}>
	<p class="proof-title__section">lattice / {sectionLabel}</p>
	<h1 id={PAGE_TITLE_ID}>{title}</h1>
	{description && <p>{description}</p>}
</header>

<style>
	.proof-title {
		max-width: 72ch;
		padding-block: clamp(1.75rem, 5vw, 3.75rem) clamp(1.5rem, 4vw, 2.5rem);
		border-bottom: 1px solid var(--lattice-rule);
	}

	.proof-title__section {
		margin: 0;
		color: var(--sl-color-gray-3);
		font-family: var(--sl-font-headings);
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.proof-title h1 {
		margin: clamp(0.75rem, 2vw, 1rem) 0 0;
		max-width: 15ch;
		color: var(--sl-color-white);
		font-family: var(--sl-font-headings);
		font-size: clamp(2.5rem, 8vw, 5rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 0.98;
		text-wrap: balance;
	}

	.proof-title > p:last-child {
		margin: clamp(1rem, 2.5vw, 1.35rem) 0 0;
		max-width: 58ch;
		color: var(--lattice-text-muted);
		font-size: clamp(1.05rem, 1.8vw, 1.22rem);
		line-height: 1.65;
		text-wrap: pretty;
	}

	@media (max-width: 52rem) {
		.proof-title h1 {
			max-width: 100%;
			font-size: clamp(2.35rem, 13vw, 4.25rem);
		}
	}
</style>
